# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (public EXPO_PUBLIC_ values only belong in eas.json; secrets never in the repository)
.env
.env*.local

# signing and store credentials (EAS local credentials, Apple keys, certificates)
credentials.json
credentials/
*.cer
*.keystore

# local Claude Code settings (the shared .claude/settings.json is tracked)
.claude/settings.local.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# visual QA (scripts/qa): web build, fixtures, screenshots and reports
.qa/
/screenshots/
